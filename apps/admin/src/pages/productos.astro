---
import AdminLayout from '../layouts/AdminLayout.astro';
import { ProductManager } from '../components/ProductManager';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8787/v1';
const storeUrl = import.meta.env.PUBLIC_STORE_URL ?? 'http://localhost:4321';
---
<AdminLayout title="Productos" section="Productos">
  <ProductManager client:load apiUrl={apiUrl} storeUrl={storeUrl} />
</AdminLayout>
