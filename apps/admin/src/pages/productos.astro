---
import AdminLayout from '../layouts/AdminLayout.astro';
import { ProductManager } from '../components/ProductManager';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8787/v1';
const supabaseUrl = import.meta.env.SUPABASE_URL ?? '';
const anonKey = import.meta.env.SUPABASE_ANON_KEY ?? '';
---
<AdminLayout title="Productos" section="Productos">
  {supabaseUrl && anonKey ? <ProductManager client:load apiUrl={apiUrl} supabaseUrl={supabaseUrl} anonKey={anonKey} /> : <div class="notice-admin">Faltan las variables de Supabase para habilitar el catálogo.</div>}
</AdminLayout>
