---
import AdminLayout from '../layouts/AdminLayout.astro';
import { OperationsManager } from '../components/OperationsManager';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8787/v1';
const supabaseUrl = import.meta.env.SUPABASE_URL ?? '';
const anonKey = import.meta.env.SUPABASE_ANON_KEY ?? '';
---
<AdminLayout title="Cupones" section="Cupones">
  {supabaseUrl && anonKey ? <OperationsManager client:load mode="coupons" apiUrl={apiUrl} supabaseUrl={supabaseUrl} anonKey={anonKey} /> : <div class="notice-admin">Faltan las variables de Supabase para habilitar cupones.</div>}
</AdminLayout>
