{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superemporio-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "api.superemporio.cl", "custom_domain": true }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PUBLIC_STORE_URL": "https://www.superemporio.cl",
    "PUBLIC_ADMIN_URL": "https://admin.superemporio.cl",
    "PUBLIC_PREVIEW_STORE_URL": "https://superemporio-storefront.pages.dev",
    "PUBLIC_PREVIEW_ADMIN_URL": "https://superemporio-admin.pages.dev"
  }
}
