---
interface Props { emoji: string; image?: string; alt?: string; tone?: string; class?: string; eager?: boolean; }
const { emoji, image, alt = '', tone = '#e8f2df', class: className = '', eager = false } = Astro.props;
---
<div class:list={['product-art', className]} style={`--art-bg:${tone}`}>
  {image
    ? <img src={image} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    : <span aria-hidden="true">{emoji}</span>}
</div>
