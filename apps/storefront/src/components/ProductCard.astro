---
import type { CatalogProduct } from '@superemporio/domain';
import ProductArt from './ProductArt.astro';
import AddToCart from './AddToCart';
import { formatCLP } from '@superemporio/domain';
interface Props { product: CatalogProduct; }
const { product } = Astro.props;
const variant = product.variants[0]!;
const toneByCategory: Record<string, string> = { 'papel-y-cocina': '#e7f1dc', limpieza: '#dff1eb', 'aseo-personal': '#f7e8d3' };
const discount = variant.compareAtPrice && variant.compareAtPrice > variant.price
  ? Math.round((1 - variant.price / variant.compareAtPrice) * 100)
  : 0;
---
<article class="product-card">
  {discount > 0 ? <span class="product-discount">-{discount}%</span> : product.badge && <span class="product-badge">{product.badge}</span>}
  <a href={`/productos/${product.slug}`} aria-label={`Ver ${product.name}`}><ProductArt emoji={product.emoji} image={product.image} alt={product.name} tone={toneByCategory[product.category] ?? '#e7f1dc'} /></a>
  <div class="product-content">
    <div class="product-brand">{product.brand}</div>
    <a class="product-name" href={`/productos/${product.slug}`}>{product.name}</a>
    <div class="product-meta"><span>{variant.label}</span>{variant.stock > 0 && variant.stock <= 5 && <b>Últimas unidades</b>}</div>
    <div class="price-row"><span class="price">{formatCLP(variant.price)}</span>{variant.compareAtPrice && <span class="compare">{formatCLP(variant.compareAtPrice)}</span>}</div>
    <AddToCart client:load product={product} variant={variant} full />
  </div>
</article>
