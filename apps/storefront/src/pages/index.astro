---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import MarketingBanner from '../components/MarketingBanner.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/catalog';

const dealProducts = products.filter((product) => product.variants.some((variant) => variant.compareAtPrice)).slice(0, 5);
const popularProducts = products.slice(0, 10);
const categoryLooks = [
  { icon: '🧻', label: 'Papel y cocina', href: '/catalogo?categoria=papel-y-cocina', image: '/campaigns/home-2026-color/hero-papel-color.webp', count: products.filter((product) => product.category === 'papel-y-cocina').length },
  { icon: '✨', label: 'Limpieza', href: '/catalogo?categoria=limpieza', image: '/campaigns/home-2026-color/hero-ahorro-color.webp', count: products.filter((product) => product.category === 'limpieza').length },
  { icon: '🫧', label: 'Aseo personal', href: '/catalogo?categoria=aseo-personal', image: '/campaigns/home-2026-color/hero-cuidado-color.webp', count: products.filter((product) => product.category === 'aseo-personal').length },
  { icon: '🏷️', label: 'Ofertas', href: '/catalogo?categoria=ofertas', image: '/campaigns/home-2026-color/franja-esenciales-color.webp', count: products.filter((product) => product.variants.some((variant) => (variant.compareAtPrice ?? variant.price) > variant.price)).length },
];

const fallbackHeroCampaigns = [
  { id: 'fallback-household', imagePath: '/campaigns/home-2026-editorial/hero-nova-precio.webp', title: 'Toalla de Papel Nova · Pack 2 rollos · $2.290', body: 'Precio especial en un esencial para tu hogar.', linkUrl: '/productos/toalla-de-papel-nova', eyebrow: 'PRECIO ESPECIAL', artworkOnly: true },
  { id: 'fallback-quix', imagePath: '/campaigns/home-2026-editorial/hero-quix-limon.webp', title: 'Lavalozas Quix Limón · Botella 750 ml · $2.190', body: 'Brillo que se nota con una fórmula concentrada y fresca.', linkUrl: '/productos/lavalozas-quix-limon', eyebrow: 'BRILLO QUE SE NOTA', artworkOnly: true },
  { id: 'fallback-omo', imagePath: '/campaigns/home-2026-editorial/hero-omo-liquido.webp', title: 'Detergente OMO Líquido · Botella 1 L · $4.290', body: 'Limpieza que rinde para el cuidado cotidiano de tu ropa.', linkUrl: '/productos/detergente-omo-liquido', eyebrow: 'LIMPIEZA QUE RINDE', artworkOnly: true },
  { id: 'fallback-dove', imagePath: '/campaigns/home-2026-editorial/hero-dove-jabon.webp', title: 'Jabón Líquido Dove · Botella 250 ml · $2.890', body: 'Cuidado suave y humectación para todos los días.', linkUrl: '/productos/jabon-liquido-dove', eyebrow: 'CUIDADO TODOS LOS DÍAS', artworkOnly: true },
];

const fallbackBanners = {
  home_intro: { title: 'Lunes de ahorro · 5% con LUNES5', body: 'Exclusivo para clientes registrados. Un uso por cuenta y válido solo los lunes.', imagePath: '/campaigns/home-2026-editorial/banner-lunes5.webp', linkUrl: '/catalogo', eyebrow: 'LUNES DE AHORRO', artworkOnly: true },
  home_offers: { title: 'Ofertas que hacen rendir tu compra', body: 'Oportunidades reales en papel, limpieza y cuidado diario.', imagePath: '/campaigns/home-2026-color/hero-papel-color.webp', linkUrl: '/catalogo?categoria=ofertas', eyebrow: 'PRECIO Y CONVENIENCIA', artworkOnly: false },
  home_favorites: { title: 'Todo para una casa limpia y lista', body: 'Reúne tus favoritos del hogar en una compra simple y cercana.', imagePath: '/campaigns/home-2026-color/hero-cuidado-color.webp', linkUrl: '/catalogo', eyebrow: 'ESENCIALES PARA TU HOGAR', artworkOnly: false },
};

type ApiCampaign = { id: string; placement: string; title: string; body: string | null; image_path: string | null; link_url: string | null; image_contains_copy?: boolean };

let heroCampaigns = fallbackHeroCampaigns;
let introBanner = fallbackBanners.home_intro;
let offersBanner = fallbackBanners.home_offers;
let favoritesBanner = fallbackBanners.home_favorites;
const apiUrl = import.meta.env.PUBLIC_API_URL?.replace(/\/$/, '');
if (apiUrl) {
  try {
    const response = await fetch(`${apiUrl}/content/campaigns`);
    const payload = response.ok ? await response.json() as { data?: ApiCampaign[] } : null;
    const campaigns = payload?.data ?? [];
    const remoteHeroes = campaigns.filter((campaign) => campaign.placement === 'hero');
    if (remoteHeroes.length) heroCampaigns = remoteHeroes.map((campaign, index) => ({
      id: campaign.id,
      title: campaign.title,
      body: campaign.body ?? fallbackHeroCampaigns[index]?.body ?? '',
      imagePath: campaign.image_path ?? fallbackHeroCampaigns[index]?.imagePath ?? fallbackHeroCampaigns[0]!.imagePath,
      linkUrl: campaign.link_url ?? fallbackHeroCampaigns[index]?.linkUrl ?? '/catalogo',
      eyebrow: fallbackHeroCampaigns[index]?.eyebrow ?? 'OFERTAS QUE SÍ CONVIENEN',
      artworkOnly: campaign.image_contains_copy ?? fallbackHeroCampaigns[index]?.artworkOnly ?? false,
    }));
    const resolveBanner = (placement: keyof typeof fallbackBanners) => {
      const fallback = fallbackBanners[placement];
      const campaign = campaigns.find((item) => item.placement === placement);
      return campaign ? { title: campaign.title, body: campaign.body ?? fallback.body, imagePath: campaign.image_path ?? fallback.imagePath, linkUrl: campaign.link_url ?? fallback.linkUrl, eyebrow: fallback.eyebrow, artworkOnly: campaign.image_contains_copy ?? fallback.artworkOnly ?? false } : fallback;
    };
    introBanner = resolveBanner('home_intro');
    offersBanner = resolveBanner('home_offers');
    favoritesBanner = resolveBanner('home_favorites');
  } catch {
    // La portada mantiene campañas locales si la API todavía no está disponible.
  }
}
---
<BaseLayout title="Superemporio | Ahorra en lo esencial para tu hogar" description="Ofertas en papel, limpieza y cuidado diario para tu hogar.">
  <section class="home-campaigns">
    <div class="container">
      <HeroCarousel campaigns={heroCampaigns} />
    </div>
  </section>

  <section class="home-banner-section home-banner-section--intro">
    <div class="container"><MarketingBanner campaign={introBanner} variant="primary" /></div>
  </section>

  <section class="confidence-strip" aria-label="Beneficios de Superemporio">
    <div class="container confidence-strip__grid">
      <div><span>🚚</span><p><b>Despacho local</b><small>Consulta cobertura por comuna</small></p></div>
      <div><span>🏷️</span><p><b>Precios convenientes</b><small>Ahorro real en lo esencial</small></p></div>
      <div><span>🛍️</span><p><b>Retiro disponible</b><small>Coordina fácilmente</small></p></div>
      <div><span>🔒</span><p><b>Compra segura</b><small>Pago protegido y simple</small></p></div>
    </div>
  </section>

  <section class="home-category-section">
    <div class="container">
      <div class="retail-section-title"><div><span>COMPRA POR CATEGORÍA</span><h2>Encuentra rápido lo que buscas</h2></div><button type="button" data-category-open aria-expanded="false" aria-controls="category-drawer">Ver todas →</button></div>
      <div class="home-category-circles">
        {categoryLooks.map((category) => (
          <a class="home-category-circle" href={category.href}>
            <span class="home-category-circle__image" style={`--category-image:url('${category.image}')`}><i aria-hidden="true">{category.icon}</i></span>
            <strong>{category.label}</strong>
            <small>{category.count} productos</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="retail-product-section retail-product-section--offers" id="ofertas">
    <div class="container">
      <div class="retail-section-title"><div><span>PRECIOS ESPECIALES</span><h2>Ofertas para aprovechar hoy</h2></div><a href="/catalogo?categoria=ofertas">Ver todas →</a></div>
      <div class="product-grid retail-product-grid">{dealProducts.map((product) => <ProductCard product={product} />)}</div>
    </div>
  </section>

  <section class="home-banner-section">
    <div class="container"><MarketingBanner campaign={offersBanner} variant="offer" /></div>
  </section>

  <section class="retail-product-section">
    <div class="container">
      <div class="retail-section-title"><div><span>FAVORITOS DEL HOGAR</span><h2>Productos que siempre necesitas</h2></div><a href="/catalogo">Ver catálogo →</a></div>
      <div class="product-grid retail-product-grid">{popularProducts.map((product) => <ProductCard product={product} />)}</div>
    </div>
  </section>

  <section class="home-banner-section home-banner-section--care">
    <div class="container"><MarketingBanner campaign={favoritesBanner} variant="care" /></div>
  </section>

  <section class="delivery-coverage" aria-labelledby="delivery-coverage-title">
    <div class="container delivery-coverage__panel">
      <figure class="delivery-coverage__map">
        <div class="delivery-coverage__map-frame">
          <img src="/maps/cobertura-santiago.svg" alt="Mapa de Santiago con La Cisterna, San Miguel y La Granja destacadas como comunas con despacho" loading="lazy" />
          <span class="delivery-coverage__price">Despacho fijo <strong>$2.990</strong></span>
        </div>
        <figcaption><span><i></i> Comunas con cobertura</span><small>Mapa adaptado de <a href="https://commons.wikimedia.org/wiki/File:Comunas_de_Santiago_(nombres).svg" target="_blank" rel="noreferrer">Osmar Valdebenito</a>, CC BY-SA 2.5.</small></figcaption>
      </figure>
      <div class="delivery-coverage__content">
        <span class="delivery-coverage__eyebrow">DESPACHO LOCAL</span>
        <h2 id="delivery-coverage-title">¿Llegamos a tu comuna?</h2>
        <p>Partimos con una cobertura simple y cercana para entregar tus compras con una tarifa clara.</p>
        <div class="delivery-coverage__communes" aria-label="Comunas con cobertura"><span>La Cisterna</span><span>San Miguel</span><span>La Granja</span></div>
        <div class="delivery-faq">
          <details open><summary>¿Dónde hacemos despachos?</summary><p>Despachamos exclusivamente en La Cisterna, San Miguel y La Granja durante esta primera etapa.</p></details>
          <details><summary>¿Cuánto cuesta el despacho?</summary><p>La tarifa es fija: $2.990 para cualquiera de las tres comunas, sin costos sorpresa.</p></details>
          <details><summary>¿Cuándo recibiré mi pedido?</summary><p>Una vez confirmado el pedido, te contactaremos para coordinar la fecha y la franja de entrega.</p></details>
          <details><summary>¿Qué pasa si mi comuna aún no tiene cobertura?</summary><p>Puedes elegir retiro coordinado o escribirnos para consultar próximas ampliaciones de cobertura.</p></details>
        </div>
      </div>
    </div>
  </section>

  <section class="home-club"><div class="container"><div class="newsletter newsletter--bright"><div><div class="eyebrow" style="color:#fff1a8">Club Superemporio</div><h2>Recibe ofertas antes que todos.</h2><p>Descuentos, packs y novedades para tu hogar.</p></div><a class="button button--yellow" href="/contacto">Quiero enterarme</a></div></div></section>
</BaseLayout>
