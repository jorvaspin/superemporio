---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Mi cuenta | Superemporio"><section class="page-intro"><div class="container"><h1>Mi cuenta</h1><p class="muted">Guarda tus direcciones y revisa tus pedidos.</p></div></section><section class="section"><div class="container" style="max-width:620px"><div class="checkout-card"><h2>Ingresa a tu cuenta</h2><p class="muted">Próximamente podrás iniciar sesión con tu correo y contraseña para consultar compras y direcciones.</p><div class="form-grid"><label class="form-field form-field--full">Correo<input type="email" placeholder="nombre@correo.cl" /></label><label class="form-field form-field--full">Contraseña<input type="password" /></label></div><button class="button" style="margin-top:1rem">Ingresar</button></div></div></section></BaseLayout>
