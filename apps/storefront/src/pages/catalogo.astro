---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories, products } from '../data/catalog';

const params = Astro.url.searchParams;
const categorySlugs = new Set(categories.map((category) => category.slug));
const requestedCategory = params.get('categoria');
const selectedCategory = requestedCategory && categorySlugs.has(requestedCategory as typeof categories[number]['slug'])
  ? requestedCategory
  : '';
const query = params.get('q')?.trim() ?? '';
const requestedOrder = params.get('orden');
const selectedOrder = ['destacados', 'nombre', 'menor-precio', 'mayor-precio'].includes(requestedOrder ?? '')
  ? requestedOrder!
  : 'destacados';

const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const minimumPrice = (product: typeof products[number]) => Math.min(...product.variants.map((variant) => variant.price));

let displayed = products.filter((product) => {
  const matchesCategory = !selectedCategory
    || (selectedCategory === 'ofertas'
      ? product.variants.some((variant) => (variant.compareAtPrice ?? variant.price) > variant.price)
      : product.category === selectedCategory);
  const searchable = normalize(`${product.name} ${product.brand} ${product.description} ${product.variants.map((variant) => variant.label).join(' ')}`);
  return matchesCategory && (!query || searchable.includes(normalize(query)));
});

if (selectedOrder === 'nombre') displayed = [...displayed].sort((a, b) => a.name.localeCompare(b.name, 'es'));
if (selectedOrder === 'menor-precio') displayed = [...displayed].sort((a, b) => minimumPrice(a) - minimumPrice(b));
if (selectedOrder === 'mayor-precio') displayed = [...displayed].sort((a, b) => minimumPrice(b) - minimumPrice(a));

const category = categories.find((item) => item.slug === selectedCategory);
const heading = query ? `Resultados para “${query}”` : category?.name ?? 'Todos los productos';
const description = query
  ? 'Productos relacionados con tu búsqueda.'
  : category?.description ?? 'Todo lo que necesitas para tu hogar, fácil de encontrar.';
---
<BaseLayout title={`${heading} | Superemporio`}>
  <section class="catalog-simple">
    <div class="container">
      <div class="catalog-simple__breadcrumbs"><a href="/">Inicio</a><span aria-hidden="true">/</span><button type="button" data-category-open aria-expanded="false" aria-controls="category-drawer">Categorías</button>{category && <><span aria-hidden="true">/</span><strong>{category.name}</strong></>}</div>

      <div class="catalog-simple__head">
        <div><h1>{heading}</h1><p>{description} <span>({displayed.length} {displayed.length === 1 ? 'producto' : 'productos'})</span></p></div>
        <form class="catalog-order" action="/catalogo" method="get" data-catalog-order-form>
          {selectedCategory && <input type="hidden" name="categoria" value={selectedCategory} />}
          {query && <input type="hidden" name="q" value={query} />}
          <label for="catalog-order">Ordenar por</label>
          <select id="catalog-order" name="orden" data-catalog-order>
            <option value="destacados" selected={selectedOrder === 'destacados'}>Destacados</option>
            <option value="nombre" selected={selectedOrder === 'nombre'}>Nombre A–Z</option>
            <option value="menor-precio" selected={selectedOrder === 'menor-precio'}>Precio: menor a mayor</option>
            <option value="mayor-precio" selected={selectedOrder === 'mayor-precio'}>Precio: mayor a menor</option>
          </select>
        </form>
      </div>

      {displayed.length > 0 ? (
        <div class="product-grid retail-product-grid catalog-simple__grid" data-simple-product-grid>
          {displayed.map((product, index) => (
            <div class="catalog-simple__product" data-simple-product data-name={normalize(product.name)} data-price={minimumPrice(product)} data-order={products.indexOf(product) ?? index}>
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      ) : (
        <div class="catalog-empty"><span aria-hidden="true">🔎</span><h2>No encontramos productos</h2><p>Prueba con otra búsqueda o revisa todas nuestras categorías.</p><button class="button button--teal" type="button" data-category-open aria-expanded="false" aria-controls="category-drawer">Explorar categorías</button></div>
      )}
    </div>
  </section>

  <script>
    const orderForm = document.querySelector<HTMLFormElement>('[data-catalog-order-form]');
    const orderSelect = document.querySelector<HTMLSelectElement>('[data-catalog-order]');
    const productGrid = document.querySelector<HTMLElement>('[data-simple-product-grid]');
    const productCards = [...document.querySelectorAll<HTMLElement>('[data-simple-product]')];

    const applyOrder = () => {
      if (!productGrid || !orderSelect) return;
      const scrollPosition = window.scrollY;
      const order = orderSelect.value;
      const ordered = [...productCards].sort((first, second) => {
        if (order === 'nombre') return String(first.dataset.name).localeCompare(String(second.dataset.name), 'es');
        if (order === 'menor-precio') return Number(first.dataset.price) - Number(second.dataset.price);
        if (order === 'mayor-precio') return Number(second.dataset.price) - Number(first.dataset.price);
        return Number(first.dataset.order) - Number(second.dataset.order);
      });
      ordered.forEach((card) => productGrid.append(card));
      productGrid.removeAttribute('data-updating');
      void productGrid.offsetWidth;
      productGrid.dataset.updating = 'true';
      window.setTimeout(() => productGrid.removeAttribute('data-updating'), 220);
      window.requestAnimationFrame(() => window.scrollTo(window.scrollX, scrollPosition));
    };

    orderForm?.addEventListener('submit', (event) => { event.preventDefault(); applyOrder(); });
    orderSelect?.addEventListener('change', applyOrder);
  </script>
</BaseLayout>
