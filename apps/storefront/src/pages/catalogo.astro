---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories, products } from '../data/catalog';

const params = Astro.url.searchParams;
const categorySlugs = new Set(categories.map((category) => category.slug));
const requestedCategory = params.get('categoria');
const selectedCategory = requestedCategory && categorySlugs.has(requestedCategory as typeof categories[number]['slug'])
  ? requestedCategory
  : '';
const onlyInStock = params.get('stock') === 'disponible';
const selectedFormats = params.getAll('formato').filter((format) => format === 'pack' || format === 'unidad');
const requestedOrder = params.get('orden');
const selectedOrder = ['destacados', 'menor-precio', 'mayor-ahorro'].includes(requestedOrder ?? '')
  ? requestedOrder!
  : 'destacados';
const query = params.get('q')?.trim() ?? '';

const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const isPack = (label: string, unitCount: number) => /pack|rollo|\bx\s*\d/i.test(label) || unitCount > 1;
const minimumPrice = (product: typeof products[number]) => Math.min(...product.variants.map((variant) => variant.price));
const maximumSaving = (product: typeof products[number]) => Math.max(0, ...product.variants.map((variant) => (variant.compareAtPrice ?? variant.price) - variant.price));

let displayed = products.filter((product) => {
  const matchesCategory = !selectedCategory
    || (selectedCategory === 'ofertas'
      ? product.variants.some((variant) => (variant.compareAtPrice ?? variant.price) > variant.price)
      : product.category === selectedCategory);
  const matchesStock = !onlyInStock || product.variants.some((variant) => variant.stock > 0);
  const matchesFormat = selectedFormats.length === 0 || product.variants.some((variant) => {
    const format = isPack(variant.label, variant.unitCount) ? 'pack' : 'unidad';
    return selectedFormats.includes(format);
  });
  const searchable = normalize(`${product.name} ${product.brand} ${product.description}`);
  const matchesQuery = !query || searchable.includes(normalize(query));
  return matchesCategory && matchesStock && matchesFormat && matchesQuery;
});

if (selectedOrder === 'menor-precio') displayed = [...displayed].sort((a, b) => minimumPrice(a) - minimumPrice(b));
if (selectedOrder === 'mayor-ahorro') displayed = [...displayed].sort((a, b) => maximumSaving(b) - maximumSaving(a));

const heading = categories.find((category) => category.slug === selectedCategory)?.name ?? 'Catálogo';
const hasActiveFilters = Boolean(selectedCategory || onlyInStock || selectedFormats.length || query || selectedOrder !== 'destacados');
---
<BaseLayout title={`${heading} | Superemporio`}>
  <section class="page-intro">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Inicio</a> / {heading}</div>
      <h1>{heading}</h1>
      <p class="muted">Encuentra esenciales para tu hogar, en formatos que convienen.</p>
    </div>
  </section>

  <div class="container catalog-layout">
    <aside class="filters">
      <form id="catalog-filters" class="filter-form" action="/catalogo" method="get">
        {query && <input type="hidden" name="q" value={query} />}
        <strong>Filtrar por</strong>

        <fieldset class="filter-group">
          <legend>Categoría</legend>
          <label><input type="radio" name="categoria" value="" checked={!selectedCategory} data-auto-submit /> Todas</label>
          {categories.map((category) => (
            <label><input type="radio" name="categoria" value={category.slug} checked={selectedCategory === category.slug} data-auto-submit />{category.name}</label>
          ))}
        </fieldset>

        <fieldset class="filter-group">
          <legend>Disponibilidad</legend>
          <label><input type="checkbox" name="stock" value="disponible" checked={onlyInStock} data-auto-submit /> En stock</label>
        </fieldset>

        <fieldset class="filter-group">
          <legend>Formato</legend>
          <label><input type="checkbox" name="formato" value="pack" checked={selectedFormats.includes('pack')} data-auto-submit /> Packs</label>
          <label><input type="checkbox" name="formato" value="unidad" checked={selectedFormats.includes('unidad')} data-auto-submit /> Unidades</label>
        </fieldset>

        <div class="filter-actions">
          <button class="button button--teal" type="submit">Aplicar filtros</button>
          {hasActiveFilters && <a href="/catalogo">Limpiar filtros</a>}
        </div>
      </form>
    </aside>

    <section aria-live="polite">
      <div class="section-heading catalog-heading">
        <p class="muted"><strong>{displayed.length}</strong> {displayed.length === 1 ? 'producto encontrado' : 'productos encontrados'}</p>
        <label class="catalog-sort">
          <span class="sr-only">Ordenar catálogo</span>
          <select name="orden" form="catalog-filters" data-auto-submit aria-label="Ordenar catálogo">
            <option value="destacados" selected={selectedOrder === 'destacados'}>Destacados</option>
            <option value="menor-precio" selected={selectedOrder === 'menor-precio'}>Menor precio</option>
            <option value="mayor-ahorro" selected={selectedOrder === 'mayor-ahorro'}>Mayor ahorro</option>
          </select>
        </label>
      </div>

      {displayed.length > 0
        ? <div class="product-grid">{displayed.map((product) => <ProductCard product={product} />)}</div>
        : <div class="catalog-empty"><span aria-hidden="true">🔎</span><h2>No encontramos productos</h2><p>Prueba quitando uno de los filtros o revisa otra categoría.</p><a class="button button--teal" href="/catalogo">Ver todo el catálogo</a></div>}
    </section>
  </div>

  <script>
    const filterForm = document.querySelector<HTMLFormElement>('#catalog-filters');
    document.querySelectorAll<HTMLElement>('[data-auto-submit]').forEach((control) => {
      control.addEventListener('change', () => filterForm?.requestSubmit());
    });
  </script>
</BaseLayout>
