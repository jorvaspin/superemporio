---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckoutForm from '../components/CheckoutForm';
const apiUrl = import.meta.env.PUBLIC_API_URL?.replace(/\/$/, '') ?? 'http://127.0.0.1:8787/v1';
---
<BaseLayout title="Finalizar compra | Superemporio"><main class="container checkout-main"><CheckoutForm client:load apiUrl={apiUrl} /></main></BaseLayout>
