{
  "name": "superemporio",
  "version": "0.1.0",
  "private": true,
  "description": "Superemporio online store",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "dev:store": "pnpm --filter @superemporio/storefront dev",
    "dev:admin": "pnpm --filter @superemporio/admin dev",
    "build": "turbo build",
    "check": "turbo check",
    "test": "turbo test",
    "format": "prettier --write .",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "node": "24.11.0",
    "prettier": "^3.5.3",
    "rea-agents": "6.7.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
