{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".astro/**"] },
    "dev": { "cache": false, "persistent": true },
    "check": { "dependsOn": ["^check"], "outputs": [] },
    "test": { "dependsOn": ["^test"], "outputs": ["coverage/**"] }
  }
}
